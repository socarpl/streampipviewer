<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StreamPipViewer</AssemblyName>
    <RootNamespace>CctvPip.App</RootNamespace>
    <Product>StreamPipViewer</Product>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\pip.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CctvPip.StreamHost\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\icon_open16.png;assets\icon_reload16.png;assets\icon_export16.png;assets\icon_import16.png" />
    <EmbeddedResource Include="assets\pip.ico" LogicalName="CctvPip.pip.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <Target Name="BuildStreamHost" BeforeTargets="Build">
    <MSBuild
      Projects="CctvPip.StreamHost\CctvPip.StreamHost.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="CopyStreamHost" AfterTargets="Build" DependsOnTargets="BuildStreamHost">
    <ItemGroup>
      <StreamHostOutput Include="CctvPip.StreamHost\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(StreamHostOutput)"
      DestinationFolder="$(TargetDir)StreamHost\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
