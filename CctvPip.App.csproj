<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CctvPip.StreamHost\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <Target Name="BuildStreamHost" BeforeTargets="Build">
    <MSBuild
      Projects="CctvPip.StreamHost\CctvPip.StreamHost.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="CopyStreamHost" AfterTargets="Build" DependsOnTargets="BuildStreamHost">
    <ItemGroup>
      <StreamHostOutput Include="CctvPip.StreamHost\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(StreamHostOutput)"
      DestinationFolder="$(TargetDir)StreamHost\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
